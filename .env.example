# Never commit a real .env — this file only shows the expected keys.
# Copy this file to .env and fill in real values; .env stays gitignored.

# ── LLM provider (Section 8.1) ─────────────────────────────────────────────
# Default: Ollama, local, no account/credit card required.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2:7b

# Opt-in only — set LLM_PROVIDER=claude and provide a real key to use Claude
# instead of the free local default. Never commit a real key here.
# ANTHROPIC_API_KEY=

# ── PostgreSQL Connection (Phase 1 Postgres adapter / converter.py) ────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── Target Schema ───────────────────────────────────────────────────────────
# All tables will be created under this schema.
PG_SCHEMA=provider

# ── Runtime Flags ───────────────────────────────────────────────────────────
# Set to false to only convert DDL without connecting to the database.
EXECUTE_DDL=true

# Set to false to skip loading sample rows from input/data/*.csv
LOAD_SAMPLE_DATA=true
